# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase (Phase 1 hosting migration — docs/planning/hosting-and-topology.md) ---
# VITE_-prefixed so Vite exposes them to client-side code (see src/services/supabaseClient.ts).
# Create a free project at https://supabase.com, then run supabase/schema.sql in its SQL Editor.
# Both values are on the project's Settings > API page. The anon key is safe to expose
# client-side by design (Row Level Security in supabase/schema.sql governs actual access).
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_ANON_KEY"

# SUPABASE_SERVICE_ROLE_KEY: server-side/Edge-Function only, NEVER exposed to the
# client (no VITE_ prefix). Used by supabase/functions/* to bypass RLS for admin
# actions (approving registrations/resets) and by scripts/migrate-users-to-supabase.mjs.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# ADMIN_EMAIL: recipient for registration/reset/profile-update approval notifications.
# Read by server.ts directly (process.env) and, separately, must also be set as a
# Supabase project secret (`supabase secrets set ADMIN_EMAIL=...`) for
# supabase/functions/* — the two are not shared automatically, set both.
ADMIN_EMAIL="YOUR_ADMIN_EMAIL"
