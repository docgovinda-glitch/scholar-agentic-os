{
  "apis": [
    {
      "api_id": "api_generate",
      "endpoint": "POST /api/generate",
      "purpose": "AI text generation via server proxy",
      "consumer": "aiGateway.callServerProxy"
    },
    {
      "api_id": "api_stream_generate",
      "endpoint": "POST /api/stream-generate",
      "purpose": "AI streaming generation via SSE",
      "consumer": "aiGateway.callServerProxyStream"
    },
    {
      "api_id": "api_parse_file",
      "endpoint": "POST /api/parse-file",
      "purpose": "Document parsing for text extraction",
      "consumer": "knowledgeVaultService.uploadAndProcessFile"
    },
    {
      "api_id": "api_register",
      "endpoint": "POST /api/register",
      "purpose": "User registration",
      "consumer": "auth"
    }
  ]
}