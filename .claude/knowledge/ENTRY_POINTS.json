{
  "entry_points": [
    {
      "entry_id": "ep_dev_server",
      "type": "dev",
      "command": "npm run dev",
      "entry_file": "server.ts",
      "description": "Vite dev server with Express middleware"
    },
    {
      "entry_id": "ep_prod_server",
      "type": "prod",
      "command": "npm start",
      "entry_file": "server.ts",
      "description": "Production server"
    },
    {
      "entry_id": "ep_build",
      "type": "build",
      "command": "npm run build",
      "entry_file": "vite.config.ts",
      "description": "Production build"
    },
    {
      "entry_id": "ep_tests",
      "type": "test",
      "command": "npm test",
      "entry_file": "vitest.config.ts",
      "description": "Test suite runner"
    }
  ]
}